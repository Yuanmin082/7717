/* 首页样式 */

.container {
  min-height: 100vh;
  background: linear-gradient(160deg, #1a4d2e 0%, #0d2e1a 100%);
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

/* 标题区域 */
.title-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.title {
  font-size: 96rpx;
  font-weight: bold;
  color: #ffd700;
  text-shadow: 0 4rpx 16rpx rgba(0,0,0,0.5);
  letter-spacing: 12rpx;
}

.subtitle {
  font-size: 32rpx;
  color: rgba(255,255,255,0.6);
  margin-top: 12rpx;
  letter-spacing: 4rpx;
}

/* 通用区块 */
.section {
  background: rgba(255,255,255,0.08);
  border-radius: 24rpx;
  padding: 32rpx;
}

.section-title {
  display: block;
  color: rgba(255,255,255,0.7);
  font-size: 28rpx;
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
}

/* 人数选择按钮 */
.count-row {
  display: flex;
  gap: 24rpx;
  justify-content: center;
}

.count-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
  border-radius: 20rpx;
  border: 3rpx solid rgba(255,255,255,0.2);
  background: rgba(255,255,255,0.05);
  transition: all 0.2s;
}

.count-btn.active {
  background: rgba(255,215,0,0.2);
  border-color: #ffd700;
}

.count-num {
  font-size: 72rpx;
  font-weight: bold;
  color: #fff;
}

.count-btn.active .count-num {
  color: #ffd700;
}

.count-label {
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
  margin-top: 4rpx;
}

/* 名字输入 */
.name-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  gap: 20rpx;
}

.name-label {
  color: rgba(255,255,255,0.7);
  font-size: 28rpx;
  min-width: 100rpx;
  flex-shrink: 0;
}

.name-input {
  flex: 1;
  background: rgba(255,255,255,0.1);
  border: 2rpx solid rgba(255,255,255,0.2);
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  color: #fff;
  font-size: 30rpx;
}

/* 规则简介 */
.rules-box {
  background: rgba(0,0,0,0.3);
  border-radius: 24rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(255,255,255,0.1);
}

.rules-title {
  display: block;
  color: #ffd700;
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.rules-text {
  display: block;
  color: rgba(255,255,255,0.65);
  font-size: 26rpx;
  line-height: 2;
}

/* 开始按钮 */
.start-btn {
  background: linear-gradient(135deg, #ffd700, #ff9800) !important;
  color: #1a2e0d !important;
  font-size: 40rpx !important;
  font-weight: bold !important;
  border-radius: 60rpx !important;
  padding: 0 !important;
  height: 108rpx !important;
  line-height: 108rpx !important;
  letter-spacing: 6rpx;
  box-shadow: 0 8rpx 32rpx rgba(255,200,0,0.4) !important;
  margin-top: 20rpx;
}
