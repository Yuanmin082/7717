/* 游戏页样式 */

.game-bg {
  min-height: 100vh;
  background: linear-gradient(160deg, #0f3320 0%, #091d12 100%);
  padding-bottom: 80rpx;
}

/* ===== 顶部信息栏 ===== */
.header {
  background: rgba(0,0,0,0.4);
  padding: 20rpx 24rpx 16rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.1);
}

.round-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.round-text {
  font-size: 28rpx;
  color: #ffd700;
  font-weight: bold;
}

.phase-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  background: rgba(255,255,255,0.1);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.score-bar {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.score-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255,255,255,0.07);
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  min-width: 100rpx;
}

.score-name {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}

.score-beans {
  font-size: 26rpx;
  font-weight: bold;
}

/* ===== 桌面牌区域 ===== */
.table-area {
  padding: 24rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.08);
}

.area-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  display: block;
  margin-bottom: 16rpx;
}

.table-cards {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.table-card-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.table-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.4);
}

.table-hint {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
  margin-top: 12rpx;
}

/* ===== 扑克牌 ===== */
.card {
  width: 72rpx;
  height: 100rpx;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 4rpx;
  border: 2rpx solid transparent;
  flex-shrink: 0;
}

.card-black {
  background: #fff;
  color: #222;
}

.card-red {
  background: #fff;
  color: #d00;
}

.card-back {
  background: linear-gradient(135deg, #1a237e, #283593);
  color: rgba(255,255,255,0.6);
  border: 2rpx solid rgba(255,255,255,0.2);
}

.back-text {
  font-size: 28rpx;
  margin: auto;
}

/* 当前轮参照牌高亮 */
.card-active {
  border: 3rpx solid #ffd700 !important;
  box-shadow: 0 0 16rpx rgba(255,215,0,0.6) !important;
}

/* 选中的牌 */
.card-selected {
  border: 3rpx solid #4caf50 !important;
  box-shadow: 0 0 16rpx rgba(76,175,80,0.6) !important;
  transform: translateY(-12rpx);
}

/* 大一点的牌（抽牌展示用） */
.card-large {
  width: 100rpx;
  height: 140rpx;
  padding: 8rpx 6rpx;
}

/* 迷你牌（排名展示用） */
.card-mini {
  width: 56rpx;
  height: 76rpx;
  padding: 4rpx 2rpx;
}

.card-rank-top {
  font-size: 20rpx;
  font-weight: bold;
  align-self: flex-start;
  line-height: 1;
}

.card-suit {
  font-size: 28rpx;
  line-height: 1;
}

.card-rank-bot {
  font-size: 20rpx;
  font-weight: bold;
  align-self: flex-end;
  line-height: 1;
  transform: rotate(180deg);
}

.mini-rank { font-size: 18rpx; font-weight: bold; align-self: flex-start; }
.mini-suit { font-size: 22rpx; }

/* ===== 阶段内容盒子 ===== */
.phase-box {
  margin: 24rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 24rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(255,255,255,0.1);
}

.phase-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #ffd700;
  margin-bottom: 20rpx;
}

.phase-desc {
  display: block;
  font-size: 30rpx;
  color: rgba(255,255,255,0.85);
  margin-bottom: 10rpx;
  line-height: 1.6;
}

.phase-desc.small {
  font-size: 24rpx;
  color: rgba(255,255,255,0.4);
}

.highlight {
  color: #ffd700;
  font-weight: bold;
}

.action-area {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.ref-label {
  display: block;
  font-size: 28rpx;
  color: rgba(255,255,255,0.7);
  margin-bottom: 8rpx;
  text-align: center;
}

.red-text { color: #f44; }

.select-hint {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  margin-bottom: 16rpx;
  text-align: center;
}

/* 手牌排列 */
.hand-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
  padding: 16rpx;
  background: rgba(0,0,0,0.2);
  border-radius: 16rpx;
}

.selected-count {
  font-size: 28rpx;
  color: rgba(255,255,255,0.7);
  margin: 8rpx 0;
}

.drawn-label {
  font-size: 28rpx;
  color: rgba(255,255,255,0.7);
}

.drawn-cards {
  display: flex;
  gap: 20rpx;
  margin: 8rpx 0;
}

.tip-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  text-align: center;
}

/* ===== 揭示阶段 ===== */
.reveal-list {
  margin: 16rpx 0;
}

.reveal-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.reveal-name {
  font-size: 28rpx;
  color: #fff;
  min-width: 100rpx;
  font-weight: bold;
}

.reveal-cards {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

/* ===== 排名展示 ===== */
.ranking-list {
  margin: 16rpx 0;
}

.ranking-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.loser-row {
  background: rgba(244,67,54,0.15);
  border: 1rpx solid rgba(244,67,54,0.3);
}

.rank-badge { font-size: 36rpx; }
.rank-name { font-size: 28rpx; color: #fff; font-weight: bold; min-width: 100rpx; }
.rank-cards { display: flex; gap: 6rpx; }
.hand-type { font-size: 26rpx; color: #ffd700; min-width: 100rpx; }
.beans-change { font-size: 28rpx; font-weight: bold; margin-left: auto; }

.loser-tip {
  padding: 16rpx;
  background: rgba(244,67,54,0.1);
  border-radius: 12rpx;
  margin: 16rpx 0;
  text-align: center;
}
.loser-tip-text { font-size: 26rpx; color: #ff8a80; }

/* ===== 游戏结束 ===== */
.end-box { text-align: center; }

.final-list { margin: 20rpx 0; }

.final-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.08);
}

.final-name { font-size: 32rpx; color: #fff; }
.final-beans { font-size: 32rpx; font-weight: bold; }

.winner-box {
  padding: 20rpx;
  background: rgba(255,215,0,0.1);
  border-radius: 16rpx;
  margin: 16rpx 0 24rpx;
}
.winner-text { font-size: 28rpx; color: rgba(255,255,255,0.6); display: block; }
.winner-name { font-size: 40rpx; color: #ffd700; font-weight: bold; display: block; margin-top: 8rpx; }

/* ===== 颜色工具类 ===== */
.pos { color: #69f0ae; }
.neg { color: #ff5252; }

/* ===== 按钮 ===== */
.btn {
  width: 100%;
  border-radius: 60rpx !important;
  font-size: 32rpx !important;
  height: 96rpx !important;
  line-height: 96rpx !important;
  margin-top: 16rpx;
  font-weight: bold !important;
  letter-spacing: 2rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #ffd700, #ff9800) !important;
  color: #1a2e0d !important;
  box-shadow: 0 6rpx 24rpx rgba(255,200,0,0.35) !important;
}

.btn-secondary {
  background: rgba(255,255,255,0.1) !important;
  color: rgba(255,255,255,0.8) !important;
  border: 1rpx solid rgba(255,255,255,0.2) !important;
}

.btn-confirm {
  background: linear-gradient(135deg, #4caf50, #388e3c) !important;
  color: #fff !important;
  box-shadow: 0 6rpx 24rpx rgba(76,175,80,0.35) !important;
}

.btn-reveal {
  background: linear-gradient(135deg, #e91e63, #c2185b) !important;
  color: #fff !important;
  box-shadow: 0 6rpx 24rpx rgba(233,30,99,0.35) !important;
}

.btn-disabled {
  background: rgba(255,255,255,0.1) !important;
  color: rgba(255,255,255,0.3) !important;
}
